{
  "design_style": {
    "vibe": "Trustworthy, empathetic, clean premium real estate",
    "personality": "Knowledgeable friend who genuinely helps property sellers",
    "visual_density": "Spacious with intentional whitespace, scannable sections",
    "rules": [
      "Every section must have one clear purpose",
      "CTAs must contrast with surrounding content",
      "Social proof appears before every major conversion point",
      "Mobile-first responsive with touch-friendly tap targets (min 48px)",
      "No decorative elements without functional purpose",
      "Maximum two font weights per section",
      "Images serve trust-building or context, never decoration"
    ]
  },
  "layout_system": {
    "grid": "CSS Grid with 12-column desktop layout",
    "containers": {
      "desktop": "1280px max-width",
      "tablet": "768px breakpoint",
      "mobile": "100% fluid with 24px horizontal padding"
    },
    "columns": {
      "desktop": 12,
      "tablet": 8,
      "mobile": 4
    },
    "spacing_scale": [4, 8, 12, 16, 20, 24, 32, 40, 48, 56, 64, 80, 96, 120],
    "vertical_rhythm": "8px base unit, sections use 80px desktop / 48px mobile"
  },
  "color_system": {
    "strategy": "Trust-first palette: deep navy conveys authority, amber/gold conveys value, green conveys positive outcomes",
    "primary": "#1B2A4A",
    "secondary": "#D4A843",
    "accent": "#2E7D52",
    "backgrounds": {
      "primary": "#FFFFFF",
      "secondary": "#F5F5F0",
      "tertiary": "#FAF8F5",
      "dark": "#1A1A2E"
    },
    "text": {
      "primary": "#1A1A2E",
      "secondary": "#5A5A6E",
      "muted": "#8A8A9E",
      "on_dark": "#FFFFFF",
      "on_primary": "#FFFFFF"
    },
    "states": {
      "error": "#D32F2F",
      "success": "#2E7D52",
      "warning": "#F59E0B",
      "info": "#2563EB"
    },
    "accessibility": "WCAG AA minimum 4.5:1 body text, 3:1 large text and UI components"
  },
  "typography": {
    "font_family": "Inter, DM Sans, system-ui, sans-serif",
    "scale": {
      "hero": { "desktop": "48px", "mobile": "32px", "weight": 700, "line_height": 1.1 },
      "h1": { "desktop": "40px", "mobile": "28px", "weight": 700, "line_height": 1.15 },
      "h2": { "desktop": "32px", "mobile": "24px", "weight": 600, "line_height": 1.2 },
      "h3": { "desktop": "24px", "mobile": "20px", "weight": 600, "line_height": 1.25 },
      "h4": { "desktop": "20px", "mobile": "18px", "weight": 500, "line_height": 1.3 },
      "body": { "desktop": "16px", "mobile": "16px", "weight": 400, "line_height": 1.6 },
      "small": { "desktop": "14px", "mobile": "14px", "weight": 400, "line_height": 1.5 },
      "button": { "desktop": "16px", "mobile": "16px", "weight": 600, "tracking": "0.5px", "transform": "uppercase" }
    },
    "weights": [400, 500, 600, 700],
    "line_height": "1.6 body, 1.15 headings",
    "rules": "Maximum two weights per visual grouping, never use light weights below 16px"
  },
  "shape_and_depth": {
    "radius": {
      "sm": "6px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "full": "9999px"
    },
    "borders": "1px solid #E0E0E0 default, 2px for active/focus states",
    "shadows": {
      "card": "0 2px 8px rgba(0,0,0,0.08)",
      "card_hover": "0 4px 16px rgba(0,0,0,0.12)",
      "dropdown": "0 8px 24px rgba(0,0,0,0.12)",
      "modal": "0 16px 48px rgba(0,0,0,0.16)"
    }
  },
  "components": {
    "buttons": {
      "primary": { "bg": "#1B2A4A", "text": "#FFFFFF", "hover_bg": "#D4A843", "height": "48px", "px": "24px", "radius": "6px" },
      "secondary": { "bg": "transparent", "text": "#1B2A4A", "border": "#1B2A4A", "hover_bg": "#F5F5F0", "height": "48px", "px": "24px", "radius": "6px" },
      "ghost": { "bg": "transparent", "text": "#1B2A4A", "hover_text": "#D4A843", "height": "48px", "px": "16px" }
    },
    "inputs": {
      "height": "48px",
      "px": "16px",
      "border": "#E0E0E0",
      "focus_border": "#1B2A4A",
      "radius": "6px",
      "bg": "#FFFFFF"
    },
    "cards": {
      "bg": "#FFFFFF",
      "border": "#E0E0E0",
      "radius": "12px",
      "shadow": "0 2px 8px rgba(0,0,0,0.08)",
      "hover_shadow": "0 4px 16px rgba(0,0,0,0.12)",
      "padding": "24px"
    },
    "navigation": {
      "height": "72px",
      "bg": "#FFFFFF",
      "shadow_on_scroll": "0 1px 4px rgba(0,0,0,0.06)",
      "mobile_breakpoint": "768px"
    },
    "modals": {
      "overlay_bg": "rgba(0,0,0,0.5)",
      "bg": "#FFFFFF",
      "radius": "16px",
      "shadow": "0 16px 48px rgba(0,0,0,0.16)",
      "max_width": "560px"
    },
    "tables": {
      "header_bg": "#F5F5F0",
      "row_hover_bg": "#FAF8F5",
      "border": "#E0E0E0",
      "cell_padding": "12px 16px"
    }
  },
  "motion": {
    "principle": "Purposeful and subtle — motion confirms actions, guides attention, never distracts",
    "timings": {
      "fast": "150ms",
      "normal": "200ms",
      "slow": "300ms",
      "page": "400ms"
    },
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "hover_effects": [
      "Button: background-color transition 200ms",
      "Card: shadow elevation + translateY(-2px) 200ms",
      "Link: color transition 150ms"
    ],
    "micro_interactions": [
      "Section fade-in-up on scroll entry (staggered children)",
      "Counter number animation on viewport entry",
      "Form field focus ring expansion",
      "Success checkmark draw animation",
      "Progress bar smooth fill"
    ]
  },
  "iconography": {
    "style": "Lucide icon set — consistent line style",
    "stroke": "1.5px stroke width at 24px size",
    "usage": "Functional only — no decorative icons without clear meaning"
  },
  "ux_principles": {
    "clarity_first": true,
    "single_primary_action": true,
    "progressive_disclosure": true,
    "reduce_cognitive_load": true,
    "predictable_patterns": true,
    "accessibility_focused": true
  }
}
